# ── Anthropic ────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Notion ────────────────────────────────────────────────────────────────────
# Integration token — create at https://www.notion.so/my-integrations
# Grant the integration access to both the database and the digest parent page.
NOTION_API_KEY=secret_...

# ID of the Notion database where individual sources are stored.
# Find it in the database URL: notion.so/{workspace}/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID of the Notion page that will contain weekly digest sub-pages.
# Find it in the page URL: notion.so/{workspace}/{PAGE_ID}
NOTION_DIGEST_PARENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
